---
import BaseLayout from '../../layouts/BaseLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Affiliate disclosure',
  description:
    'How Pick Your Row handles advertising, affiliate links, and editorial independence. Joshua Israel Ventures LLC.',
  url: 'https://pickyourrow.com/disclosure/',
};
---
<BaseLayout
  title="Affiliate disclosure"
  description="How Pick Your Row handles advertising, affiliate links, and editorial independence. No invented partner IDs. Joshua Israel Ventures LLC."
  canonicalPath="/disclosure/"
  jsonLd={jsonLd}
>
  <div class="wrap prose">
    <nav class="breadcrumb"><a href="/">Home</a> / Disclosure</nav>
    <h1 class="page-title">Affiliate disclosure</h1>
    <p class="lede">
      Transparency first. If you buy or book through a partner link on this site, Pick Your Row may earn a commission.
      That does not change the price you pay.
    </p>

    <h2>Current status (November 2026)</h2>
    <p>
      The site carries Google AdSense advertising. It has no live affiliate links and no booking buttons.
      We do <strong>not</strong> invent affiliate IDs, tracking tokens, or fake “Book now” deep links.
    </p>

    <h2>What stays independent</h2>
    <ul class="clean">
      <li>Original SVG cabin schematics are editorial products, not paid airline placements.</li>
      <li>Best seat scores are heuristic opinions documented on <a href="/methodology/">Methodology</a>.</li>
      <li>We are not affiliated with, endorsed by, or sponsored by any airline.</li>
    </ul>

    <h2>FTC style principles</h2>
    <p>
      When partner links go live, we will label them as affiliate or sponsored where required, keep this disclosure
      easy to find from the footer, and list active programs here.
    </p>

    <h2>Questions</h2>
    <p>
      Email via <a href="/contact/">Contact</a>, or read <a href="/about/">About Pick Your Row</a>.
      Accuracy limits and other notices are on our <a href="/disclaimer/">Disclaimer</a> page.
      Owner: Joshua Israel Ventures LLC.
    </p>

    <p class="btn-row">
      <a class="btn" href="/methodology/">Methodology</a>
      <a class="btn secondary" href="/airlines/">Browse airlines</a>
    </p>
    <p class="muted legal-ownership">© 2026 Joshua Israel Ventures LLC. All rights reserved. Pick Your Row is a trade name of Joshua Israel Ventures LLC, a Florida limited liability company.</p>
  </div>
</BaseLayout>
