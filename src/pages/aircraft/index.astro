---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUniqueAircraftTypes } from '../../data';

const types = getUniqueAircraftTypes().sort((a, b) => a.label.localeCompare(b.label));
---
<BaseLayout title="Aircraft types directory: cabin schematics by jet" description="Browse aircraft families and typical cabin schematics. Compare airline configs for the same type. Original SVGs only. Illustrative layouts vary by registration.">
  <div class="wrap">
    <nav class="breadcrumb"><a href="/">Home</a> / Aircraft</nav>
    <h1 class="page-title">Aircraft types</h1>
    <p class="lede">Each type page lists airline-specific illustrative configs we have reconstructed as original schematics.</p>
    <nav class="hub-links" aria-label="Related hubs">
      <a href="/airlines/">Airlines directory</a>
      <a href="/guides/">Guides index</a>
      <a href="/methodology/">Methodology</a>
      <a href="/disclosure/">Affiliate disclosure</a>
    </nav>
    <div class="grid cols-2">
      {types.map((t) => (
        <article class="card">
          <h2><a href={`/aircraft/${t.typeSlug}/`}>{t.label}</a></h2>
          <p>{t.configs.length} config{t.configs.length === 1 ? '' : 's'} across {new Set(t.configs.map((c) => c.airlineSlug)).size} airline(s)</p>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
