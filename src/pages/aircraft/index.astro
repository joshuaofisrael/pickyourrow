---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUniqueAircraftTypes } from '../../data';
import { breadcrumbItemList } from '../../lib/schema';
import {
  AIRCRAFT_DIRECTORY_TITLE,
  aircraftDirectoryDescription,
  assertDirectoryCopy,
} from '../../lib/typeHubMeta';

const types = getUniqueAircraftTypes().sort((a, b) => a.label.localeCompare(b.label));
const directoryDescription = aircraftDirectoryDescription(types.length);
assertDirectoryCopy(AIRCRAFT_DIRECTORY_TITLE, directoryDescription);

const jsonLd = breadcrumbItemList({
  crumbs: [
    { name: 'Home', path: '/' },
    { name: 'Aircraft', path: '/aircraft/' },
  ],
  listName: 'Aircraft types with cabin schematics',
  items: types.map((t) => ({
    name: t.label,
    path: `/aircraft/${t.typeSlug}/`,
  })),
});
---
<BaseLayout
  title={AIRCRAFT_DIRECTORY_TITLE}
  description={directoryDescription}
  canonicalPath="/aircraft/"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <nav class="breadcrumb"><a href="/">Home</a> / Aircraft</nav>
    <h1 class="page-title">Aircraft types</h1>
    <p class="lede">Each type page compares the airline seat maps drawn for that aircraft, including approximate seats, economy seat layout, and a link to the seating chart.</p>
    <nav class="hub-links" aria-label="Related hubs">
      <a href="/airlines/">Airlines directory</a>
      <a href="/best-seats/">Best seats index</a>
      <a href="/guides/">Guides index</a>
      <a href="/methodology/">Methodology</a>
      <a href="/disclosure/">Affiliate disclosure</a>
    </nav>
    <div class="grid cols-2">
      {types.map((t) => (
        <article class="card">
          <h2><a href={`/aircraft/${t.typeSlug}/`}>{t.label}</a></h2>
          <p>{t.configs.length} config{t.configs.length === 1 ? '' : 's'} across {new Set(t.configs.map((c) => c.airlineSlug)).size} airline(s)</p>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
