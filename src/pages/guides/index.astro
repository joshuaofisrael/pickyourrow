---
import BaseLayout from '../../layouts/BaseLayout.astro';
import guides from '../../data/guides.json';
import { breadcrumbItemList } from '../../lib/schema';

const featuredSlugs = ['seat-map-glossary', 'cabin-class-primer', 'how-pickyourrow-scores-work', 'exit-row-tips'];
const featured = featuredSlugs.flatMap((s) => {
  const guide = guides.find((g) => g.slug === s);
  return guide ? [guide] : [];
});
const rest = guides.filter((g) => !featuredSlugs.includes(g.slug));
const listed = [...featured, ...rest];

const jsonLd = breadcrumbItemList({
  crumbs: [
    { name: 'Home', path: '/' },
    { name: 'Guides', path: '/guides/' },
  ],
  listName: 'Seat selection guides',
  items: listed.map((g) => ({
    name: g.title,
    path: `/guides/${g.slug}/`,
  })),
});
---
<BaseLayout
  title="Seat selection guides"
  description="Evergreen guides on seat map terms, cabin classes, family seating, overnight strategy, LCC fees, Pick Your Row scores, exit rows, and bulkheads. Cited sources. Internal links to airline maps."
  canonicalPath="/guides/"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <nav class="breadcrumb"><a href="/">Home</a> / Guides</nav>
    <h1 class="page-title">Guides</h1>
    <p class="lede">
      Original Pick Your Row articles on reading a seat map, choosing a row, and understanding cabin products.
      Each card below is one published guide. For scoring rules and outbound citations to public authorities, see
      <a href="/methodology/">Methodology and sources</a>.
    </p>
    <nav class="hub-links" aria-label="Related hubs">
      <a href="/airlines/">Airlines directory</a>
      <a href="/aircraft/">Aircraft index</a>
      <a href="/best-seats/">Best seats index</a>
      <a href="/methodology/">Methodology</a>
      <a href="/book/">Booking stub</a>
    </nav>
    <h2 class="section-head" style="margin-top:1.25rem">Start here</h2>
    <div class="grid cols-2" style="margin-top:0.75rem">
      {featured.map((g) => (
        <article class="card">
          <h2><a href={`/guides/${g.slug}/`}>{g.title}</a></h2>
          <p>{g.description}</p>
        </article>
      ))}
    </div>
    <h2 class="section-head" style="margin-top:2rem">All guides</h2>
    <div class="grid cols-2" style="margin-top:0.75rem">
      {rest.map((g) => (
        <article class="card">
          <h2><a href={`/guides/${g.slug}/`}>{g.title}</a></h2>
          <p>{g.description}</p>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
