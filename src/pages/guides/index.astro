---
import BaseLayout from '../../layouts/BaseLayout.astro';
import guides from '../../data/guides.json';
---
<BaseLayout title="Guides" description="Evergreen guides on family seating, overnight long-haul strategy, LCC seat fees, Pick Your Row scores, exit rows, bulkheads, and how to read schematics.">
  <div class="wrap">
    <nav class="breadcrumb"><a href="/">Home</a> / Guides</nav>
    <h1 class="page-title">Guides</h1>
    <div class="grid cols-2">
      {guides.map((g) => (
        <article class="card">
          <h2><a href={`/guides/${g.slug}/`}>{g.title}</a></h2>
          <p>{g.description}</p>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
