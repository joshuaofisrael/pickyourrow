---
import Photo from '../../components/Photo.astro';
import Byline from '../../components/Byline.astro';
import RelatedReads from '../../components/RelatedReads.astro';
import CompareBox from '../../components/CompareBox.astro';
import { photoForText } from '../../lib/photos';
import { PUBLISHER } from '../../lib/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';
import guides from '../../data/guides.json';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug } }));
}

const { slug } = Astro.params;
const guide = guides.find((g) => g.slug === slug)!;
type Source = { label: string; url: string; note?: string };
const sources = ((guide as { sources?: Source[] }).sources ?? []) as Source[];
type Fig = { src: string; alt: string; caption?: string };
const heroImage = (guide as { heroImage?: Fig }).heroImage;
const figures = ((guide as { figures?: Fig[] }).figures ?? []) as Fig[];

const relatedPriority = [
  'seat-map-glossary',
  'cabin-class-primer',
  'how-pickyourrow-scores-work',
  'exit-row-tips',
  'aisle-vs-window',
  'bulkhead-seats',
];
const explicitRelated = ((guide as { related?: string[] }).related ?? []).filter((item) => item !== slug);
const relatedGuides = (
  explicitRelated.length
    ? explicitRelated.flatMap((item) => {
        const found = guides.find((g) => g.slug === item);
        return found ? [found] : [];
      })
    : [
        ...guides.filter((g) => g.slug !== slug && relatedPriority.includes(g.slug)),
        ...guides.filter((g) => g.slug !== slug && !relatedPriority.includes(g.slug)),
      ]
).slice(0, 4);
const relatedItems = relatedGuides.map((g) => ({
  href: `/guides/${g.slug}/`,
  title: g.title,
  description: g.description,
  photo: photoForText(g.title + ' ' + g.slug, g.slug),
}));
const midSplit = Math.max(1, Math.ceil(guide.body.length / 2));
const bodyFirst = guide.body.slice(0, midSplit);
const bodyRest = guide.body.slice(midSplit);

function linkParts(text: string): { text: string; href?: string }[] {
  return text
    .split(/(\[[^\]]+\]\(\/[^)]+\))/g)
    .filter(Boolean)
    .map((part) => {
      const match = part.match(/^\[([^\]]+)\]\((\/[^)]+)\)$/);
      if (!match) return { text: part };
      return { text: match[1], href: match[2] };
    });
}

type FaqItem = { question: string; answer: string };
const faqs = ((guide as { faq?: FaqItem[] }).faq ?? []) as FaqItem[];
const datePublished = (guide as { datePublished?: string }).datePublished;
const dateModified = (guide as { dateModified?: string }).dateModified ?? datePublished;
const published = (guide as { published?: string }).published ?? datePublished;
const updated = (guide as { updated?: string }).updated ?? published;
type CompareLink = { href: string; label: string };
const compare = (
  guide as { compare?: { heading?: string; intro: string; links: CompareLink[] } }
).compare;

/** Link targets may contain hyphens. Visible labels and prose may not. */
function visibleProse(text: string): string {
  return text.replace(/\[([^\]]+)\]\(\/[^)]+\)/g, '$1');
}

const pagePath = `/guides/${guide.slug}/`;
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.title,
    description: guide.description,
    url: `https://pickyourrow.com${pagePath}`,
    author: PUBLISHER,
    publisher: PUBLISHER,
    ...((published || datePublished) ? { datePublished: published ?? datePublished, dateModified: updated ?? dateModified } : {}),
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `https://pickyourrow.com${pagePath}`,
    },
    ...(heroImage ? { image: new URL(heroImage.src, 'https://pickyourrow.com').toString() } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pickyourrow.com/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://pickyourrow.com/guides/' },
      { '@type': 'ListItem', position: 3, name: guide.title, item: `https://pickyourrow.com${pagePath}` },
    ],
  },
];

if (faqs.length > 0) {
  const chunks: { label: string; text: string }[] = [
    { label: 'title', text: guide.title },
    { label: 'description', text: guide.description },
    ...guide.body.map((text, index) => ({ label: `body ${index + 1}`, text })),
    ...faqs.flatMap((item, index) => [
      { label: `faq question ${index + 1}`, text: item.question },
      { label: `faq answer ${index + 1}`, text: item.answer },
    ]),
  ];
  for (const chunk of chunks) {
    if (/[-–—]/.test(visibleProse(chunk.text))) {
      throw new Error(`Guide prose contains a dash (${guide.slug} ${chunk.label})`);
    }
  }

  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  });
}
---
<BaseLayout title={guide.title} description={guide.description} canonicalPath={pagePath} ogImage={heroImage?.src} jsonLd={jsonLd}>
  <div class="wrap prose">
    <nav class="breadcrumb"><a href="/">Home</a> / <a href="/guides/">Guides</a> / {guide.title}</nav>
    <h1 class="page-title">{guide.title}</h1>
    <Byline />
    <p class="lede">{guide.description}</p>
    {heroImage && (
      <figure class="guide-hero">
        <img src={heroImage.src} alt={heroImage.alt} width="1200" height="675" loading="eager" />
        <figcaption>
          {heroImage.caption ? heroImage.caption + ' ' : 'AI generated illustration. '}
          <a href="/image-policy/">Image policy</a>.
        </figcaption>
      </figure>
    )}
    {!heroImage && <Photo name={photoForText(guide.title + ' ' + guide.slug, guide.slug)} variant="banner" eager />}
    {bodyFirst.map((p) => (
      <p>
        {linkParts(p).map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}
      </p>
    ))}
    {relatedItems.length > 0 && (
      <RelatedReads heading="Keep reading" items={relatedItems} />
    )}
    {bodyRest.map((p) => (
      <p>
        {linkParts(p).map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}
      </p>
    ))}
    {figures.map((f) => (
      <figure class="guide-figure">
        <img src={f.src} alt={f.alt} width="900" height="675" loading="lazy" />
        <figcaption>
          {f.caption ? f.caption + ' ' : 'AI generated illustration. '}
          <a href="/image-policy/">Image policy</a>.
        </figcaption>
      </figure>
    ))}

    {faqs.length > 0 && (
      <>
        <h2>FAQ</h2>
        <div class="faq-block">
          {faqs.map((item) => (
            <div>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </div>
          ))}
        </div>
      </>
    )}

    {sources.length > 0 && (
      <>
        <h2>Sources and references</h2>
        <p class="muted">
          Outbound links to authoritative public pages. Regulatory and consumer-rights material is <strong>fact</strong>;
          our seat scores remain <strong>editorial</strong>. See also the
          {' '}<a href="/methodology/">Methodology &amp; sources</a> page.
        </p>
        <ol class="sources">
          {sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener noreferrer">{s.label}</a>
              {s.note ? `. ${s.note}` : ''}
            </li>
          ))}
        </ol>
      </>
    )}

    <CompareBox
      heading={compare?.heading ?? 'Check a seat map'}
      intro={
        compare?.intro ??
        'When you are ready to match this guide to a cabin drawing, open an airline hub or the aircraft index.'
      }
      links={
        compare?.links ?? [
          { href: '/airlines/', label: 'Airlines directory' },
          { href: '/aircraft/', label: 'Aircraft index' },
          { href: '/best-seats/', label: 'Best seats directory' },
          { href: '/guides/', label: 'All guides' },
        ]
      }
    />

    <p class="btn-row">
      <a class="btn" href="/airlines/">Browse airline seat maps</a>
      <a class="btn secondary" href="/methodology/">Methodology</a>
      <a class="btn secondary" href="/guides/">More guides</a>
    </p>
    {relatedItems.length > 0 && (
      <RelatedReads heading="Related guides" items={relatedItems} />
    )}
  </div>
</BaseLayout>
