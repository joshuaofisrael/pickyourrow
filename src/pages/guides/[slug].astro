---
import { PUBLISHER } from '../../lib/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';
import guides from '../../data/guides.json';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug } }));
}

const { slug } = Astro.params;
const guide = guides.find((g) => g.slug === slug)!;
type Source = { label: string; url: string; note?: string };
const sources = ((guide as { sources?: Source[] }).sources ?? []) as Source[];
type Fig = { src: string; alt: string; caption?: string };
const heroImage = (guide as { heroImage?: Fig }).heroImage;
const figures = ((guide as { figures?: Fig[] }).figures ?? []) as Fig[];

const relatedPriority = [
  'seat-map-glossary',
  'cabin-class-primer',
  'how-pickyourrow-scores-work',
  'exit-row-tips',
  'aisle-vs-window',
  'bulkhead-seats',
];
const related = [
  ...guides.filter((g) => g.slug !== slug && relatedPriority.includes(g.slug)),
  ...guides.filter((g) => g.slug !== slug && !relatedPriority.includes(g.slug)),
].slice(0, 4);

function linkParts(text: string): { text: string; href?: string }[] {
  return text
    .split(/(\[[^\]]+\]\(\/[^)]+\))/g)
    .filter(Boolean)
    .map((part) => {
      const match = part.match(/^\[([^\]]+)\]\((\/[^)]+)\)$/);
      if (!match) return { text: part };
      return { text: match[1], href: match[2] };
    });
}

type FaqItem = { question: string; answer: string };
const faqs = ((guide as { faq?: FaqItem[] }).faq ?? []) as FaqItem[];

/** Link targets may contain hyphens. Visible labels and prose may not. */
function visibleProse(text: string): string {
  return text.replace(/\[([^\]]+)\]\(\/[^)]+\)/g, '$1');
}

const pagePath = `/guides/${guide.slug}/`;
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.title,
    description: guide.description,
    url: `https://pickyourrow.com${pagePath}`,
    author: PUBLISHER,
    publisher: PUBLISHER,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `https://pickyourrow.com${pagePath}`,
    },
    ...(heroImage ? { image: new URL(heroImage.src, 'https://pickyourrow.com').toString() } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pickyourrow.com/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://pickyourrow.com/guides/' },
      { '@type': 'ListItem', position: 3, name: guide.title, item: `https://pickyourrow.com${pagePath}` },
    ],
  },
];

if (faqs.length > 0) {
  const chunks: { label: string; text: string }[] = [
    { label: 'title', text: guide.title },
    { label: 'description', text: guide.description },
    ...guide.body.map((text, index) => ({ label: `body ${index + 1}`, text })),
    ...faqs.flatMap((item, index) => [
      { label: `faq question ${index + 1}`, text: item.question },
      { label: `faq answer ${index + 1}`, text: item.answer },
    ]),
  ];
  for (const chunk of chunks) {
    if (/[-–—]/.test(visibleProse(chunk.text))) {
      throw new Error(`Guide prose contains a dash (${guide.slug} ${chunk.label})`);
    }
  }

  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  });
}
---
<BaseLayout title={guide.title} description={guide.description} canonicalPath={pagePath} ogImage={heroImage?.src} jsonLd={jsonLd}>
  <div class="wrap prose">
    <nav class="breadcrumb"><a href="/">Home</a> / <a href="/guides/">Guides</a> / {guide.title}</nav>
    <h1 class="page-title">{guide.title}</h1>
    <p class="lede">{guide.description}</p>
    {heroImage && (
      <figure class="guide-hero">
        <img src={heroImage.src} alt={heroImage.alt} width="1200" height="675" loading="eager" />
        {heroImage.caption && <figcaption>{heroImage.caption}</figcaption>}
      </figure>
    )}
    {guide.body.map((p) => (
      <p>
        {linkParts(p).map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}
      </p>
    ))}
    {figures.map((f) => (
      <figure class="guide-figure">
        <img src={f.src} alt={f.alt} width="900" height="675" loading="lazy" />
        {f.caption && <figcaption>{f.caption}</figcaption>}
      </figure>
    ))}

    {faqs.length > 0 && (
      <>
        <h2>FAQ</h2>
        <div class="faq-block">
          {faqs.map((item) => (
            <div>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </div>
          ))}
        </div>
      </>
    )}

    {sources.length > 0 && (
      <>
        <h2>Sources and references</h2>
        <p class="muted">
          Outbound links to authoritative public pages. Regulatory and consumer-rights material is <strong>fact</strong>;
          our seat scores remain <strong>editorial</strong>. See also the
          {' '}<a href="/methodology/">Methodology &amp; sources</a> page.
        </p>
        <ol class="sources">
          {sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener noreferrer">{s.label}</a>
              {s.note ? `. ${s.note}` : ''}
            </li>
          ))}
        </ol>
      </>
    )}

    <p class="btn-row">
      <a class="btn" href="/airlines/">Browse airline seat maps</a>
      <a class="btn secondary" href="/methodology/">Methodology</a>
      <a class="btn secondary" href="/guides/">More guides</a>
    </p>
    {related.length > 0 && (
      <>
        <h2>Related guides</h2>
        <ul class="clean">
          {related.map((g) => (
            <li><a href={`/guides/${g.slug}/`}>{g.title}</a>. {g.description}</li>
          ))}
        </ul>
      </>
    )}
  </div>
</BaseLayout>
