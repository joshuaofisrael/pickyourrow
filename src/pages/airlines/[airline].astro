---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { airlines, getAircraftByAirline, getUniqueAircraftTypes, layoutString } from '../../data';
import type { AircraftConfig } from '../../data/types';
import { assertIndefiniteArticleSamples, indefiniteArticle } from '../../lib/englishArticle';
import { aircraftUrlParam } from '../../lib/resolve';
import { breadcrumbItemList } from '../../lib/schema';
import { exitRowPhrase } from '../../lib/typeHubMeta';
import guides from '../../data/guides.json';

export function getStaticPaths() {
  assertIndefiniteArticleSamples();
  for (const carrier of airlines) {
    const carrierArticle = indefiniteArticle(carrier.name);
    if (`${carrierArticle} ${carrier.name}`.includes('an United')) {
      throw new Error(`Bad indefinite article for ${carrier.name}: ${carrierArticle}`);
    }
  }
  return airlines.map((a) => ({ params: { airline: a.slug } }));
}

const { airline: slug } = Astro.params;
const airline = airlines.find((a) => a.slug === slug)!;
const configs = getAircraftByAirline(slug!);
const pagePath = `/airlines/${airline.slug}/`;
const typeSlugByLabel = new Map(getUniqueAircraftTypes().map((entry) => [entry.label, entry.typeSlug]));

function listNames(names: string[]): string {
  if (names.length === 0) return '';
  if (names.length === 1) return names[0];
  if (names.length === 2) return `${names[0]} and ${names[1]}`;
  return `${names.slice(0, -1).join(', ')}, and ${names[names.length - 1]}`;
}

/** Economy block pattern in words, so FAQ prose does not add layout hyphens. */
function blocksPhrase(layout: string): string {
  const parts = layout.split('-');
  if (parts.length === 1) return `a single block of ${parts[0]}`;
  if (parts.length === 2) return `blocks of ${parts[0]} and ${parts[1]}`;
  return `blocks of ${parts.slice(0, -1).join(', ')}, and ${parts[parts.length - 1]}`;
}

function economyLayoutSentence(layouts: string[], singularCard: boolean): string {
  const phrases = layouts.map(blocksPhrase);
  if (phrases.length === 1) {
    return singularCard
      ? `The economy section on this card uses ${phrases[0]}.`
      : `Every economy section on these cards uses ${phrases[0]}.`;
  }
  if (phrases.length === 2) {
    return `Economy sections on these cards use ${phrases[0]}, or ${phrases[1]}.`;
  }
  return `Economy sections on these cards use ${phrases.slice(0, -1).join(', ')}, or ${phrases[phrases.length - 1]}.`;
}

const configCount = configs.length;
const example = configs[0];
const exampleType = example?.aircraftType ?? '';
const exampleParam = example ? aircraftUrlParam(example) : '';
const exampleSeatMap = example ? `/airlines/${airline.slug}/${exampleParam}/seat-map/` : '';
const exampleBest = example ? `/best-seats/${airline.slug}/${exampleParam}/` : '';
const bestHub = `/best-seats/${airline.slug}/`;
const typeList = listNames(configs.map((config) => config.aircraftType));
const seatCounts = configs.map((config) => config.totalSeatsApprox);
const minSeats = configCount ? Math.min(...seatCounts) : 0;
const maxSeats = configCount ? Math.max(...seatCounts) : 0;
const seatPhrase =
  configCount === 0
    ? 'no seats drawn yet'
    : minSeats === maxSeats
      ? `about ${minSeats} seats`
      : `about ${minSeats} to ${maxSeats} seats`;
const layouts = [...new Set(configs.map((config) => layoutString(config)))].sort();
const article = indefiniteArticle(airline.name);

/** Cabin product names for prose. Hyphens in stored labels become spaces. */
function proseCabinLabel(label: string): string {
  return label.replace(/[-–—]/g, ' ').replace(/\s{2,}/g, ' ').trim();
}

function cabinProductsPhrase(config: AircraftConfig): string {
  const labels = config.cabins.map((cabin) => proseCabinLabel(cabin.label)).filter((label) => label.length > 0);
  if (labels.length === 0) return 'None listed';
  return listNames(labels);
}

function exitMarkSentence(types: string[], rows: number[]): string {
  const subject = listNames(types.map((type) => `the ${type}`));
  const plural = types.length > 1;
  const listed = listNames(rows.map(String));
  const action =
    rows.length === 0
      ? plural
        ? 'do not mark an exit row'
        : 'does not mark an exit row'
      : rows.length === 1
        ? plural
          ? `mark exit row ${listed}`
          : `marks exit row ${listed}`
        : plural
          ? `mark exit rows ${listed}`
          : `marks exit rows ${listed}`;
  const sentence = `${subject} ${action}.`;
  return sentence.charAt(0).toUpperCase() + sentence.slice(1);
}

/** Which drawn configs mark which exit rows. Uses config.exitRows only. */
function exitRowSummary(drawn: AircraftConfig[]): string {
  const groups = new Map<string, { rows: number[]; types: string[] }>();
  for (const config of drawn) {
    const key = config.exitRows.join(',');
    const existing = groups.get(key);
    if (existing) existing.types.push(config.aircraftType);
    else groups.set(key, { rows: [...config.exitRows], types: [config.aircraftType] });
  }
  return [...groups.values()].map((group) => exitMarkSentence(group.types, group.rows)).join(' ');
}
const seatMapLabel = configCount === 1 ? 'seat map' : 'seat maps';
const findSentence =
  configCount === 0
    ? `No illustrative configs are published for ${airline.name} yet.`
    : configCount === 1
      ? 'You will find 1 illustrative config, linked to a seat map and a best seats page.'
      : `You will find ${configCount} illustrative configs, each linked to a seat map and a best seats page.`;

const fleetAnswer =
  configCount === 0
    ? `This page does not list a cabin for ${airline.name} yet, so there is nothing here to compare. Aircraft in the real ${airline.name} fleet can still differ by registration.`
    : configCount === 1
      ? `This page shows one illustrative ${exampleType} config, with ${seatPhrase}. ${economyLayoutSentence(layouts, true)} That drawing is a typical example, not proof that every ${airline.name} aircraft matches it. Another registration can move galleys, lavatories, or row counts.`
      : layouts.length === 1
        ? `The economy block pattern matches on every card here, so that pattern does not vary in this set. Every card uses ${blocksPhrase(layouts[0])}. The cabins are still separate interiors. ${configCount} configs are drawn, and seat counts run ${seatPhrase}. Galleys, lavatories, and exit rows can differ by aircraft type and by registration. Aircraft on this page: ${typeList}.`
        : `Yes. These ${configCount} configs already disagree on economy layout. ${economyLayoutSentence(layouts, false)} Drawn seat counts run ${seatPhrase}. Aircraft on this page: ${typeList}. Another registration can still change the cabin again.`;

const countParts: { text: string; href?: string }[] =
  configCount === 0
    ? [
        {
          text: `This page shows 0 illustrative configs for ${airline.name}, IATA code ${airline.iata}. A seat map will appear here after a cabin is drawn. Until then, confirm any seat with ${airline.name}.`,
        },
      ]
    : [
        {
          text:
            configCount === 1
              ? `This page shows 1 illustrative config for ${airline.name}, IATA code ${airline.iata}: ${typeList}. Drawn seat counts run ${seatPhrase}. Open the card for the cabin sketch. The drawing is the `
              : `This page shows ${configCount} illustrative configs for ${airline.name}, IATA code ${airline.iata}: ${typeList}. Drawn seat counts run ${seatPhrase}. Open a card for the cabin sketch. One example is the `,
        },
        { text: `${airline.name} ${exampleType} seat map`, href: exampleSeatMap },
        { text: '. The same aircraft has a ' },
        { text: 'best seats page', href: exampleBest },
        { text: '.' },
      ];

const pickParts: { text: string; href?: string }[] =
  configCount === 0
    ? [
        {
          text: `No ${airline.name} seat map is published here yet, so do not choose a row from a guess. Confirm the live map with ${airline.name}. Scoring rules are in the `,
        },
        { text: 'methodology', href: '/methodology/' },
        { text: '.' },
      ]
    : [
        {
          text:
            configCount === 1
              ? `Open the card above, then read that seat map before you pay for a row. Extra space often sits at an exit or a bulkhead, and ${airline.name} sets the rules and the fee. A window or an aisle is a preference. Highlights on Pick Your Row are opinions for planning, not a seat the airline is holding for you. The shortlist for this drawing is the `
              : `Match a card above to the aircraft on your ticket, then read that seat map before you pay for a row. Extra space often sits at an exit or a bulkhead, and ${airline.name} sets the rules and the fee. A window or an aisle is a preference. Highlights on Pick Your Row are opinions for planning, not a seat the airline is holding for you. Browse every shortlist on the `,
        },
        {
          text: `best seats page for ${airline.name}`,
          href: configCount === 1 ? exampleBest : bestHub,
        },
        ...(configCount === 1
          ? []
          : [
              { text: '. One worked example is the ' },
              { text: `${airline.name} ${exampleType} best seats page`, href: exampleBest },
            ]),
        { text: '. Scoring rules are in the ' },
        { text: 'methodology', href: '/methodology/' },
        { text: '. The guide on ' },
        { text: 'how Pick Your Row scores work', href: '/guides/how-pickyourrow-scores-work/' },
        { text: ' explains the heuristic.' },
      ];

const answerParts: { text: string; href?: string }[] =
  configCount === 0
    ? [
        {
          text: `No illustrative ${airline.name} seat map is published here yet. A seating plan will appear on this hub after a cabin is drawn. Confirm any seat with ${airline.name}, or browse the `,
        },
        { text: 'aircraft index', href: '/aircraft/' },
        { text: ' for types drawn on other carriers.' },
      ]
    : configCount === 1
      ? [
          {
            text: `This ${airline.name} seat map is an original illustrative seating plan for 1 config, ${exampleType}, and the drawn cabin runs ${seatPhrase}. Open the `,
          },
          { text: `${airline.name} ${exampleType} seat map`, href: exampleSeatMap },
          { text: ' if it matches the aircraft on your ticket, or read the ' },
          { text: 'best seats page', href: exampleBest },
          {
            text: ` for the editorial shortlist. Confirm the live cabin with ${airline.name} before you pay for a seat. The fleet summary lists illustrative exit rows and cabin products for this drawing. If the type name is unclear, use `,
          },
          {
            text: 'how to verify your aircraft type',
            href: '/guides/how-to-verify-your-aircraft-type/',
          },
          { text: '.' },
        ]
      : [
          {
            text: `These ${airline.name} seat maps are original illustrative seating plans for ${configCount} configs (${typeList}), and drawn cabins run ${seatPhrase}. Match the aircraft on your ticket to a fleet table row or a card below, then open that seat map, such as the `,
          },
          { text: `${airline.name} ${exampleType} seat map`, href: exampleSeatMap },
          { text: ', or its ' },
          { text: 'best seats page', href: exampleBest },
          {
            text: `. Confirm the live cabin with ${airline.name} before you pay for a seat. The fleet summary compares illustrative exit rows and cabin products across these drawings. If the type name is unclear, use `,
          },
          {
            text: 'how to verify your aircraft type',
            href: '/guides/how-to-verify-your-aircraft-type/',
          },
          { text: '.' },
        ];

const fleetIntroParts: { text: string; href?: string }[] = [
  {
    text: `Each row is one illustrative ${airline.name} config. The illustrative exit rows and cabin products columns compare what that drawing stores, and you should still confirm both with ${airline.name}. The aircraft name opens the shared type page. Seat map opens that cabin sketch. Best seats opens the editorial shortlist. Match the type on your ticket before you choose a row. The guide on `,
  },
  {
    text: 'how to verify your aircraft type',
    href: '/guides/how-to-verify-your-aircraft-type/',
  },
  { text: ' explains that check.' },
];
const fleetCaption = `${airline.name} seating plans on this hub`;

const whereParts: { text: string; href?: string }[] =
  configCount === 0
    ? [
        {
          text: `No ${airline.name} seat map is published on this hub yet. Use the live map from ${airline.name}. Types drawn for other carriers are listed in the `,
        },
        { text: 'aircraft index', href: '/aircraft/' },
        { text: '.' },
      ]
    : [
        {
          text: `Start with the fleet table on this page. Each row is an illustrative ${airline.name} seating plan and links to that aircraft seat map. One cabin sketch is the `,
        },
        { text: `${airline.name} ${exampleType} seat map`, href: exampleSeatMap },
        {
          text: `. The official diagram is on the ${airline.name} site or in the airline app, and it can differ by registration. To match a ticket to a row here, use `,
        },
        {
          text: 'how to verify your aircraft type',
          href: '/guides/how-to-verify-your-aircraft-type/',
        },
        { text: '. Other types on Pick Your Row are listed in the ' },
        { text: 'aircraft index', href: '/aircraft/' },
        { text: '.' },
      ];

const planIndexSentence =
  configCount === 1 ? 'This hub lists that one plan.' : `This hub lists all ${configCount} drawn plans.`;

const planParts: { text: string; href?: string }[] =
  configCount === 0
    ? [
        {
          text: `There is no ${airline.name} seating plan to open here yet. When a config is drawn, the plan will be an original cabin sketch with a seat map and a best seats page. This hub would be the index. An aircraft seat map would be that one cabin. Until then, confirm the layout with ${airline.name}.`,
        },
      ]
    : [
        {
          text: `It is one original cabin sketch for a single ${airline.name} config, not a copy of the airline chart. ${economyLayoutSentence(layouts, configCount === 1)} Drawn cabins on this hub run ${seatPhrase}. ${planIndexSentence} An aircraft seat map is the sketch for one config only, for example the `,
        },
        { text: `${airline.name} ${exampleType} seat map`, href: exampleSeatMap },
        { text: '. The ' },
        {
          text: `best seats page for ${airline.name}`,
          href: configCount === 1 ? exampleBest : bestHub,
        },
        { text: ' is the editorial shortlist for the same drawings. The ' },
        { text: 'methodology', href: '/methodology/' },
        { text: ` explains the scores. Confirm the live plan with ${airline.name}.` },
      ];

/** Visible FAQ and FAQPage schema share this copy so the markup matches the page. */
const faqs: { question: string; parts: { text: string; href?: string }[] }[] = [
  {
    question: `Where can I find ${article} ${airline.name} seat map?`,
    parts: whereParts,
  },
  {
    question: `What does ${article} ${airline.name} seating plan show?`,
    parts: planParts,
  },
  {
    question: `What is this ${airline.name} page for?`,
    parts: [
      {
        text: `This page groups the original ${airline.name} cabin schematics on Pick Your Row. ${airline.name} uses IATA code ${airline.iata} and is based in ${airline.country}. ${findSentence} Use it when you already know the carrier and want the aircraft we have drawn for it. If you know the type first, start from the `,
      },
      { text: 'aircraft index', href: '/aircraft/' },
      {
        text: `. Maps here are illustrative planning sketches. Confirm the aircraft and the live seat map with ${airline.name} before you pay for a row.`,
      },
    ],
  },
  {
    question: `Are these official ${airline.name} seat maps?`,
    parts: [
      {
        text: `No. Every drawing on this page is an original illustrative schematic. Pick Your Row is not affiliated with ${airline.name}, and these are not the official ${airline.name} seat maps. If a carrier diagram and a card disagree, trust ${airline.name}. The `,
      },
      { text: 'methodology', href: '/methodology/' },
      { text: ' page explains how editorial scores differ from regulatory facts.' },
    ],
  },
  {
    question: `How many aircraft configs are shown for ${airline.name}?`,
    parts: countParts,
  },
  {
    question: `How should I pick a seat on ${airline.name}?`,
    parts: pickParts,
  },
  {
    question: `Do cabin layouts vary within the ${airline.name} fleet?`,
    parts: [{ text: fleetAnswer }],
  },
  {
    question:
      configCount === 0
        ? `Which exit rows are marked for ${airline.name}?`
        : `Which exit rows are marked on ${configCount === 1 ? 'this' : 'these'} ${airline.name} ${seatMapLabel}?`,
    parts:
      configCount === 0
        ? [
            {
              text: `No illustrative ${airline.name} config is drawn here, so this hub does not mark an exit row. Confirm any exit with ${airline.name}. The `,
            },
            { text: 'methodology', href: '/methodology/' },
            { text: ' page explains how these sketches are drawn. ' },
            { text: 'Exit row tips', href: '/guides/exit-row-tips/' },
            { text: ' cover who should skip an exit and why a marked row is not a promise.' },
          ]
        : [
            {
              text: `${exitRowSummary(configs)} These row numbers are illustrative and can differ by registration. Confirm them with ${airline.name} before you pay for an exit seat. The `,
            },
            { text: 'methodology', href: '/methodology/' },
            { text: ' page explains how these sketches are drawn. ' },
            { text: 'Exit row tips', href: '/guides/exit-row-tips/' },
            { text: ' cover who should skip an exit and why a marked row is not a promise. A sample sketch is the ' },
            { text: `${airline.name} ${exampleType} seat map`, href: exampleSeatMap },
            { text: '.' },
          ],
  },
  {
    question: "How do I confirm my flight's aircraft before relying on a map?",
    parts: [
      {
        text: `Your ticket or the ${airline.name} app usually prints the aircraft type, and the assignment can still change before departure. Match that name to a card on this page, then open that seat map. Use the guide on `,
      },
      {
        text: 'how to verify your aircraft type',
        href: '/guides/how-to-verify-your-aircraft-type/',
      },
      {
        text: `. If ${airline.name} names an aircraft that is not drawn here, use the live airline map instead of a nearby type.`,
      },
    ],
  },
];

const pageTitle = `${airline.name} ${seatMapLabel} and seating plan`;
const pageDescription =
  configCount === 0
    ? `No illustrative ${airline.name} seat map is published here yet. Confirm any seat with ${airline.name}.`
    : configCount === 1
      ? `Illustrative ${airline.name} seat map for 1 aircraft. Drawn cabin: ${seatPhrase}. Match your ticket, then confirm with ${airline.name}.`
      : `Illustrative ${airline.name} seat maps for ${configCount} aircraft. Drawn cabins: ${seatPhrase}. Match your ticket, then confirm with ${airline.name}.`;

const allowedLabels = [airline.name, airline.iata, ...configs.map((config) => config.aircraftType)]
  .filter((label) => label.length > 0)
  .sort((a, b) => b.length - a.length);

function assertNoDash(kind: string, raw: string) {
  let stripped = raw;
  for (const label of allowedLabels) stripped = stripped.split(label).join('');
  if (/[-–—]/.test(stripped)) {
    throw new Error(`${kind} contains a dash outside airline or aircraft labels (${airline.name}): ${stripped}`);
  }
}

for (const item of faqs) {
  assertNoDash('FAQ prose', `${item.question} ${item.parts.map((part) => part.text).join('')}`);
}
assertNoDash('Page title', pageTitle);
assertNoDash('Meta description', pageDescription);
assertNoDash('H1', `${airline.name} ${seatMapLabel} (${airline.iata})`);
assertNoDash('Answer', answerParts.map((part) => part.text).join(''));
if (configCount > 0) {
  assertNoDash('Fleet intro', fleetIntroParts.map((part) => part.text).join(''));
  assertNoDash('Fleet caption', fleetCaption);
  for (const config of configs) {
    assertNoDash('Economy layout cell', blocksPhrase(layoutString(config)));
    assertNoDash('Exit rows cell', exitRowPhrase(config));
    assertNoDash('Cabin products cell', cabinProductsPhrase(config));
  }
}

const jsonLd = [
  ...breadcrumbItemList({
    crumbs: [
      { name: 'Home', path: '/' },
      { name: 'Airlines', path: '/airlines/' },
      { name: airline.name, path: pagePath },
    ],
    listName: `${airline.name} cabin configs`,
    items: configs.map((c) => {
      const ap = aircraftUrlParam(c);
      return {
        name: `${airline.name} ${c.aircraftType}`,
        path: `/airlines/${airline.slug}/${ap}/seat-map/`,
      };
    }),
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.parts.map((part) => part.text).join(''),
      },
    })),
  },
];
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={pagePath}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <nav class="breadcrumb"><a href="/">Home</a> / <a href="/airlines/">Airlines</a> / {airline.name}</nav>
    <h1 class="page-title">{airline.name} {seatMapLabel} <span class="muted">({airline.iata})</span></h1>
    <p class="lede">{airline.blurb}</p>
    <p class="note">
      Pick Your Row is not affiliated with, endorsed by, or sponsored by {airline.name}. Maps are original schematics.
    </p>
    <p class="answer-block">
      {answerParts.map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}
    </p>
    <nav class="hub-links" aria-label="Related hubs">
      {configs.length > 0 && (
        <a href={`/best-seats/${airline.slug}/`}>Best seats on {airline.name}</a>
      )}
      <a href="/airlines/">Airlines directory</a>
      <a href="/best-seats/">All best seats</a>
      <a href="/aircraft/">Aircraft index</a>
      <a href="/guides/">Guides index</a>
      <a href="/methodology/">Methodology</a>
    </nav>
    {configCount > 0 && (
      <section aria-labelledby="fleet-summary">
        <h2 id="fleet-summary">Fleet summary</h2>
        <p>
          {fleetIntroParts.map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}
        </p>
        <div class="table-scroll">
          <table class="fleet hub-fleet">
            <caption>{fleetCaption}</caption>
            <thead>
              <tr>
                <th scope="col">Aircraft</th>
                <th scope="col">Approximate seats</th>
                <th scope="col">Economy layout</th>
                <th scope="col">Illustrative exit rows</th>
                <th scope="col">Cabin products</th>
                <th scope="col">Seat map</th>
                <th scope="col">Best seats</th>
              </tr>
            </thead>
            <tbody>
              {configs.map((c) => {
                const ap = aircraftUrlParam(c);
                const typeSlug = typeSlugByLabel.get(c.aircraftType);
                return (
                  <tr>
                    <th scope="row">
                      {typeSlug ? <a href={`/aircraft/${typeSlug}/`}>{c.aircraftType}</a> : c.aircraftType}
                    </th>
                    <td>{c.totalSeatsApprox}</td>
                    <td>{blocksPhrase(layoutString(c))}</td>
                    <td>{exitRowPhrase(c)}</td>
                    <td class="products">{cabinProductsPhrase(c)}</td>
                    <td><a href={`/airlines/${airline.slug}/${ap}/seat-map/`}>Seat map</a></td>
                    <td><a href={`/best-seats/${airline.slug}/${ap}/`}>Best seats</a></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    )}
    <div class="grid cols-2">
      {configs.map((c) => {
        const ap = aircraftUrlParam(c);
        return (
          <article class="card">
            <h2><a href={`/airlines/${airline.slug}/${ap}/seat-map/`}>{c.aircraftType}</a></h2>
            <p>About {c.totalSeatsApprox} seats. Economy uses {blocksPhrase(layoutString(c))}.</p>
            <p class="btn-row">
              <a href={`/airlines/${airline.slug}/${ap}/seat-map/`}>Seat map</a>
              ·
              <a href={`/best-seats/${airline.slug}/${ap}/`}>Best seats</a>
            </p>
          </article>
        );
      })}
    </div>

    <h2>Airline FAQ</h2>
    <div class="prose faq-block">
      {faqs.map((faq) => (
        <div>
          <h3>{faq.question}</h3>
          <p>
            {faq.parts.map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}
          </p>
        </div>
      ))}
    </div>

    <section style="margin-top:2rem">
      <h2>Helpful seat guides</h2>
      <p class="muted">Original Pick Your Row articles, useful alongside these {airline.name} schematics.</p>
      <ul class="clean">
        {guides.filter((g) => ['how-to-verify-your-aircraft-type', 'seat-map-glossary', 'cabin-class-primer', 'exit-row-tips', 'how-pickyourrow-scores-work'].includes(g.slug)).map((g) => (
          <li><a href={`/guides/${g.slug}/`}>{g.title}</a>. {g.description}</li>
        ))}
      </ul>
