---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import SeatMap from '../../../../../components/SeatMap.astro';
import BookingCTA from '../../../../../components/BookingCTA.astro';
import { airlines, aircraftConfigs, layoutString } from '../../../../../data';
import { assertLeafMeta, leafDescription, leafHeading, leafTitle, softenProseDashes } from '../../../../../lib/leafMeta';
import { peerSeatMaps, siblingSeatMaps, typeHubAnchor, typeHubPath } from '../../../../../lib/relatedSeatMaps';
import { resolveAirlineAircraft, aircraftUrlParam } from '../../../../../lib/resolve';
import { topSeats } from '../../../../../lib/scoring';
import guides from '../../../../../data/guides.json';

export function getStaticPaths() {
  assertLeafMeta(airlines, aircraftConfigs);
  return aircraftConfigs.map((c) => ({
    params: {
      airline: c.airlineSlug,
      aircraft: aircraftUrlParam(c),
    },
  }));
}

const { airline: aSlug, aircraft: acParam } = Astro.params;
const resolved = resolveAirlineAircraft(aSlug!, acParam!);
if (!resolved) throw new Error('Config not found');
const { airline, config } = resolved;
const tops = topSeats(config, 5);
const bestSeatsHref = `/best-seats/${airline.slug}/${acParam}/`;
const typeHubHref = typeHubPath(config);
const typeHubLabel = typeHubAnchor(config.aircraftType);
const siblingMaps = siblingSeatMaps(config, airlines, aircraftConfigs);
const peerMaps = peerSeatMaps(config, airlines, aircraftConfigs);
const cabinSummary = config.cabins.map((c) => c.label).join(', ');
const highlightIds = tops.map((s) => s.seatId).join(', ') || 'none listed';
const exitLabel = config.exitRows.length ? config.exitRows.join(', ') : 'none marked';
const layout = layoutString(config);

/** Visible FAQ and FAQPage schema share this copy so the markup matches the page. */
const faqs: { question: string; parts: { text: string; href?: string }[] }[] = [
  {
    question: `How do I read this ${airline.name} ${config.aircraftType} seat map?`,
    parts: [
      {
        text: `Read rows from the nose toward the tail. Seat letters sit in blocks, and the gaps between blocks are aisles. On this ${airline.name} ${config.aircraftType} schematic the economy style layout is ${layout}. Cabins shown: ${cabinSummary}. About ${config.totalSeatsApprox} seats are drawn. Green seats (${highlightIds}) are sample editorial picks, not a held reservation. Match the row on your boarding pass to this drawing, then confirm the live map with the airline.`,
      },
    ],
  },
  {
    question: `Is this the official ${airline.name} seat map?`,
    parts: [
      {
        text: `No. This is an original illustrative schematic, not the official ${airline.name} diagram. Pick Your Row is not affiliated with ${airline.name}. The drawing uses publicly known typical configuration facts so you can see cabin shape before you book. If the airline map and this page disagree, trust the airline. How scores differ from regulatory facts is explained in the `,
      },
      { text: 'methodology', href: '/methodology/' },
      { text: '.' },
    ],
  },
  {
    question: `Do all ${config.aircraftType} aircraft use this layout?`,
    parts: [
      {
        text: softenProseDashes(
          `${config.configNote} Exit rows marked here: ${exitLabel}. Treat this ${airline.name} ${config.aircraftType} map as one typical example. Another registration can move galleys, lavatories, or row counts.`,
        ),
      },
    ],
  },
  {
    question: 'Which seats are highlighted and why?',
    parts: [
      {
        text: `Green seats on this schematic are sample editorial picks: ${highlightIds}. The highlight flags seats our heuristic ranks highly for space or position on this drawing, often an exit row, a bulkhead, a window, or an aisle. It is an opinion for planning, not an airline assignment. Full rationale is on the `,
      },
      {
        text: `best seats page for this ${airline.name} ${config.aircraftType}`,
        href: bestSeatsHref,
      },
      { text: '.' },
    ],
  },
  {
    question: 'Where are the exit rows on this schematic?',
    parts: [
      {
        text: `Exit rows drawn on this ${airline.name} ${config.aircraftType} seat map: ${exitLabel}. They show where extra space often sits on this typical layout. Carriers set their own exit seat rules. If you cannot assist in an evacuation, pick a different row. Context for those rules is in the `,
      },
      { text: 'methodology', href: '/methodology/' },
      { text: ' and on the ' },
      { text: 'best seats page', href: bestSeatsHref },
      { text: '.' },
    ],
  },
  {
    question: 'How do I confirm my aircraft before flying?',
    parts: [
      {
        text: `After you book, the ticket or the ${airline.name} app usually names the aircraft type, and that type can still change. Match it to this ${config.aircraftType} page, then open the airline seat map for your flight. A checklist lives in the guide on `,
      },
      {
        text: 'how to verify your aircraft type',
        href: '/guides/how-to-verify-your-aircraft-type/',
      },
      {
        text: '. If that airline map disagrees with this schematic, trust the airline. Configurations vary by registration.',
      },
    ],
  },
];

const pagePath = `/airlines/${airline.slug}/${acParam}/seat-map/`;
const pageTitle = leafTitle(airline, config);
const pageDescription = leafDescription(airline, config);
const heading = leafHeading(airline, config);
const documentTitle = `${pageTitle} · Pick Your Row`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: documentTitle,
    description: pageDescription,
    url: `https://pickyourrow.com${pagePath}`,
    isPartOf: { '@type': 'WebSite', name: 'Pick Your Row', url: 'https://pickyourrow.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pickyourrow.com/' },
      { '@type': 'ListItem', position: 2, name: 'Airlines', item: 'https://pickyourrow.com/airlines/' },
      { '@type': 'ListItem', position: 3, name: airline.name, item: `https://pickyourrow.com/airlines/${airline.slug}/` },
      { '@type': 'ListItem', position: 4, name: config.aircraftType, item: `https://pickyourrow.com${typeHubHref}` },
      { '@type': 'ListItem', position: 5, name: `${config.aircraftType} seat map`, item: `https://pickyourrow.com${pagePath}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.parts.map((p) => p.text).join(''),
      },
    })),
  },
];

/** Stable variety of related guides (not always the first four). */
function relatedGuides(seed: string, count = 4) {
  let h = 0;
  for (let i = 0; i < seed.length; i++) h = (h * 31 + seed.charCodeAt(i)) >>> 0;
  const scored = guides.map((g, i) => {
    const slugBoost =
      (config.exitRows.length && /exit|bulkhead|legroom/i.test(g.slug) ? 3 : 0) +
      (config.cabins.some((c) => c.cabinClass === 'premium') && /premium/i.test(g.slug) ? 2 : 0) +
      (config.cabins.length === 1 && /low-cost|lcc|fee/i.test(g.slug) ? 2 : 0) +
      (/window|wing|aisle|couple|connect|bassinet|overnight|kid|pitch|verify|checklist/i.test(g.slug) ? 1 : 0);
    return { g, score: slugBoost * 100 + ((h + i * 17) % 97) };
  });
  scored.sort((a, b) => b.score - a.score);
  return scored.slice(0, count).map((x) => x.g);
}
const related = relatedGuides(config.slug);
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={pagePath}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <nav class="breadcrumb">
      <a href="/">Home</a> /
      <a href="/airlines/">Airlines</a> /
      <a href={`/airlines/${airline.slug}/`}>{airline.name}</a> /
      <a href={typeHubHref}>{config.aircraftType}</a> /
      Seat map
    </nav>
    <h1 class="page-title">{heading}</h1>
    <p class="lede">
      Typical layout. About {config.totalSeatsApprox} seats. Economy style layout {layoutString(config)}.
      Exit rows {config.exitRows.join(', ') || 'none marked'}. Cabins: {cabinSummary}.
    </p>
    <p class="note">{softenProseDashes(config.configNote)}</p>

    <div class="sticky-best-cta" aria-label="Quick actions">
      <a class="btn" href={bestSeatsHref}>Editorial best seats</a>
      <a class="btn secondary" href="#booking-cta">Compare flights</a>
      <a class="btn secondary" href={`/airlines/${airline.slug}/`}>All {airline.name} aircraft</a>
    </div>

    <SeatMap config={config} highlight={tops.map((s) => s.seatId)} bestSeatsHref={bestSeatsHref} />

    <p class="muted" style="margin-top:0.75rem">
      Green highlighted seats are sample editorial picks ({tops.map((s) => s.seatId).join(', ')}).
      Full rationale on the <a href={bestSeatsHref}>best seats page</a>.
    </p>

    <div id="booking-cta">
      <BookingCTA
        airlineName={airline.name}
        aircraftType={config.aircraftType}
        cabinHint={cabinSummary}
        bestSeatsHref={bestSeatsHref}
      />
    </div>

    <h2>Cabin sections</h2>
    <ul class="clean">
      {config.cabins.map((cab) => (
        <li>
          <strong>{cab.label}</strong> ({cab.cabinClass}): rows {cab.startRow} to {cab.endRow}, layout{' '}
          {cab.layout.map((b) => b.letters.length).join('-')} ({cab.layout.map((b) => b.letters.join('')).join(' | ')})
        </li>
      ))}
    </ul>

    {config.notes.length > 0 && (
      <>
        <h2>Notes</h2>
        <ul class="clean">
          {config.notes.map((n) => <li>{softenProseDashes(n)}</li>)}
        </ul>
      </>
    )}

    <h2>Trust signals</h2>
    <ul class="clean">
      <li>Original SVG schematics only. Never scraped competitor maps.</li>
      <li><a href="/methodology/">Methodology</a> explains editorial scores versus regulatory facts.</li>
      <li><a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/disclosure/">Affiliate disclosure</a></li>
    </ul>

    <h2>Seat map FAQ</h2>
    <div class="prose faq-block">
      {faqs.map((f) => (
        <div>
          <h3>{f.question}</h3>
          <p>
            {f.parts.map((p) => (p.href ? <a href={p.href}>{p.text}</a> : p.text))}
          </p>
        </div>
      ))}
    </div>

    <section class="related-maps" aria-labelledby="related-seat-maps">
      <h2 id="related-seat-maps">Related seat maps</h2>
      <p class="muted">Use these links to compare this fleet and this aircraft type.</p>
      <p><a href={typeHubHref}>{typeHubLabel}</a></p>
      {siblingMaps.length > 0 && (
        <>
          <h3>Other {airline.name} seat maps</h3>
          <ul class="related-links">
            {siblingMaps.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </>
      )}
      {peerMaps.length > 0 && (
        <>
          <h3>Other {config.aircraftType} seat maps</h3>
          <ul class="related-links">
            {peerMaps.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </>
      )}
    </section>

    <h2>Related reading</h2>
    <ul class="clean">
      {related.map((g) => (
        <li><a href={`/guides/${g.slug}/`}>{softenProseDashes(g.title)}</a>. {softenProseDashes(g.description)}</li>
      ))}
    </ul>
    <p class="btn-row">
      <a class="btn secondary" href="/guides/">All guides</a>
      <a class="btn secondary" href="/methodology/">Methodology</a>
      <a class="btn secondary" href={`/airlines/${airline.slug}/`}>More {airline.name} maps</a>
      <a class="btn secondary" href="/aircraft/">Aircraft index</a>
    </p>
  </div>
</BaseLayout>
