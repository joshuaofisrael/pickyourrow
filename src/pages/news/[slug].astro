---
import Photo from '../../components/Photo.astro';
import Byline from '../../components/Byline.astro';
import RelatedReads from '../../components/RelatedReads.astro';
import CompareBox from '../../components/CompareBox.astro';
import { photoForText } from '../../lib/photos';
import { PUBLISHER } from '../../lib/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';
import news from '../../data/news.json';
import guides from '../../data/guides.json';

type Source = { label: string; url: string; note?: string };
type Post = {
  slug: string;
  title: string;
  description: string;
  datePublished: string;
  dateModified?: string;
  airlineSlug?: string;
  body: string[];
  sources: Source[];
};

export function getStaticPaths() {
  // Link targets may contain hyphens. Visible labels and prose may not.
  const visibleProse = (text: string) => text.replace(/\[([^\]]+)\]\(\/[^)]+\)/g, '$1');
  for (const post of news as Post[]) {
    for (const text of [post.title, post.description, ...post.body]) {
      if (/[-–—]/.test(visibleProse(text))) {
        throw new Error(`News prose contains a dash (${post.slug}): ${text.slice(0, 60)}`);
      }
    }
    if (!/^\d{4}-\d{2}-\d{2}$/.test(post.datePublished)) throw new Error(`Bad news date (${post.slug})`);
    if (post.sources.length < 2) throw new Error(`News post needs at least two sources (${post.slug})`);
  }
  return (news as Post[]).map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = (news as Post[]).find((p) => p.slug === slug)!;
const pagePath = `/news/${post.slug}/`;
const url = `https://pickyourrow.com${pagePath}`;
const modified = post.dateModified ?? post.datePublished;
const displayDate = new Date(`${post.datePublished}T12:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});

function linkParts(text: string): { text: string; href?: string }[] {
  return text
    .split(/(\[[^\]]+\]\(\/[^)]+\))/g)
    .filter(Boolean)
    .map((part) => {
      const match = part.match(/^\[([^\]]+)\]\((\/[^)]+)\)$/);
      if (!match) return { text: part };
      return { text: match[1], href: match[2] };
    });
}

const otherNews = (news as Post[])
  .filter((n) => n.slug !== post.slug)
  .slice(0, 2)
  .map((n) => ({
    href: `/news/${n.slug}/`,
    title: n.title,
    description: n.description,
    photo: photoForText(n.title, n.slug),
  }));
const relatedGuides = guides
  .filter((g) =>
    ['how-to-verify-your-aircraft-type', 'seat-map-glossary', 'cabin-class-primer', 'how-pickyourrow-scores-work'].includes(
      g.slug,
    ),
  )
  .slice(0, 2)
  .map((g) => ({
    href: `/guides/${g.slug}/`,
    title: g.title,
    description: g.description,
    photo: photoForText(g.title, g.slug),
  }));
const relatedItems = [...otherNews, ...relatedGuides].slice(0, 4);
const midSplit = Math.max(1, Math.ceil(post.body.length / 2));
const bodyFirst = post.body.slice(0, midSplit);
const bodyRest = post.body.slice(midSplit);

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: post.title,
    description: post.description,
    url,
    datePublished: post.datePublished,
    dateModified: modified,
    author: PUBLISHER,
    publisher: PUBLISHER,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    citation: post.sources.map((s) => s.url),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pickyourrow.com/' },
      { '@type': 'ListItem', position: 2, name: 'News', item: 'https://pickyourrow.com/news/' },
      { '@type': 'ListItem', position: 3, name: post.title, item: url },
    ],
  },
];
---
<BaseLayout title={post.title} description={post.description} canonicalPath={pagePath} jsonLd={jsonLd}>
  <div class="wrap prose">
    <nav class="breadcrumb"><a href="/">Home</a> / <a href="/news/">News</a> / {post.title}</nav>
    <h1 class="page-title">{post.title}</h1>
    <Byline date={post.datePublished} dateLabel={`Published ${displayDate}`} />
    <p class="lede">{post.description}</p>
    <Photo name={photoForText(post.title, post.slug)} variant="banner" eager />
    {bodyFirst.map((p) => (
      <p>{linkParts(p).map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}</p>
    ))}
    {relatedItems.length > 0 && <RelatedReads heading="Keep reading" items={relatedItems} />}
    {bodyRest.map((p) => (
      <p>{linkParts(p).map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}</p>
    ))}

    <h2>Sources</h2>
    <p class="muted">Written in our own words from the sources below. Airline products change, so confirm details with the airline before you fly.</p>
    <ol class="sources">
      {post.sources.map((s) => (
        <li><a href={s.url} rel="noopener noreferrer">{s.label}</a>{s.note ? `. ${s.note}` : ''}</li>
      ))}
    </ol>

    <CompareBox
      heading="Check related maps"
      intro="Open the matching airline hub or a seat selection guide after you read the announcement."
      links={[
        ...(post.airlineSlug
          ? [
              { href: `/airlines/${post.airlineSlug}/`, label: 'Seat maps for this airline' },
              { href: `/best-seats/${post.airlineSlug}/`, label: 'Best seats for this airline' },
            ]
          : []),
        { href: '/news/', label: 'All news' },
        { href: '/guides/', label: 'Seat guides' },
      ]}
    />

    <p class="btn-row">
      {post.airlineSlug && <a class="btn" href={`/airlines/${post.airlineSlug}/`}>Seat maps for this airline</a>}
      <a class="btn secondary" href="/news/">All news</a>
      <a class="btn secondary" href="/guides/">Seat guides</a>
    </p>
    {relatedItems.length > 0 && <RelatedReads heading="Related reading" items={relatedItems} />}
  </div>
</BaseLayout>
