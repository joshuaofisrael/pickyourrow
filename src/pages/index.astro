---
import BaseLayout from '../layouts/BaseLayout.astro';
import { airlines, aircraftConfigs, layoutString, getAircraftByAirline } from '../data';
import { aircraftUrlParam } from '../lib/resolve';
import guides from '../data/guides.json';

const featured = [
  ...aircraftConfigs.slice(-6),
  ...aircraftConfigs.slice(0, 2),
].filter((c, i, arr) => arr.findIndex((x) => x.slug === c.slug) === i).slice(0, 8);
const airlineCards = airlines.map((a) => ({
  ...a,
  count: getAircraftByAirline(a.slug).length,
}));
const inventoryLine = `${airlines.length} airlines, ${aircraftConfigs.length} aircraft configs, ${guides.length} guides`;

const featuredGuideSlugs = [
  'seat-map-glossary',
  'cabin-class-primer',
  'how-pickyourrow-scores-work',
  'exit-row-tips',
  'seat-pitch-and-width-explained',
  'how-to-verify-your-aircraft-type',
  'seat-selection-checklist-before-you-fly',
  'unassigned-seats-versus-paid-selection',
];
const featuredGuides = [
  ...featuredGuideSlugs.map((s) => guides.find((g) => g.slug === s)).filter(Boolean),
  ...guides.filter((g) => !featuredGuideSlugs.includes(g.slug)),
].slice(0, 6);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Pick Your Row',
    legalName: 'Joshua Israel Ventures LLC',
    url: 'https://pickyourrow.com/',
    email: 'joshuaofisrael@gmail.com',
    description:
      'Original airline cabin schematics and editorial best seat guidance. Not affiliated with any airline.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Pick Your Row',
    url: 'https://pickyourrow.com/',
    description:
      'Original schematic seat maps and editorial best seat tips for popular airline aircraft.',
    publisher: {
      '@type': 'Organization',
      name: 'Joshua Israel Ventures LLC',
      url: 'https://pickyourrow.com/',
    },
  },
];
---
<BaseLayout
  title="Pick Your Row: airline seat maps and cabin guides"
  description="Original schematic seat maps and editorial best seat tips for popular airline aircraft. Browse by airline, pick a smarter row, then use our booking placeholder when you are ready. Not affiliated with any airline."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section class="hero wrap">
    <p class="badge">Original schematics · editorial guidance</p>
    <h1>See the cabin. Pick a smarter row. Book with eyes open.</h1>
    <p class="lede">
      Pick Your Row publishes original SVG cabin schematics and plain English seat notes for common airline
      configurations. Rebuilt from publicly known layout facts. Never scraped from competitor maps.
      Currently covering {inventoryLine}.
    </p>
    <div class="btn-row">
      <a class="btn" href="/airlines/">Browse airlines</a>
      <a class="btn secondary" href="/methodology/">Methodology and sources</a>
      <a class="btn secondary" href="/guides/">Seat selection guides</a>
    </div>
    <p class="note info">
      Configurations vary by aircraft registration and retrofit. Treat every map as an illustrative schematic and
      confirm seats with your airline. We are not affiliated with any carrier.
    </p>
  </section>

  <section class="wrap trust-row" aria-label="Trust signals">
    <div class="trust-row__grid">
      <div class="trust-row__item">
        <strong>Original only</strong>
        <span>Hand built SVG schematics. No scraped SeatGuru or airline PDF diagrams.</span>
      </div>
      <div class="trust-row__item">
        <strong>Editorial scores</strong>
        <span>Transparent heuristics on <a href="/methodology/">Methodology</a>. Not airline advice.</span>
      </div>
      <div class="trust-row__item">
        <strong>Clear disclosure</strong>
        <span>Booking placeholders link to <a href="/disclosure/">disclosure</a> and <a href="/book/">/book/</a>.</span>
      </div>
      <div class="trust-row__item">
        <strong>Human contact</strong>
        <span><a href="/about/">About</a> Joshua Israel Ventures LLC · <a href="/contact/">Contact</a></span>
      </div>
    </div>
  </section>

  <section class="wrap" style="margin-bottom:2rem">
    <div class="section-head">
      <h2>Featured guides</h2>
      <a href="/guides/">All guides →</a>
    </div>
    <div class="grid cols-3" style="margin-top:1rem">
      {featuredGuides.map((g) => (
        <article class="card">
          <h3><a href={`/guides/${g!.slug}/`}>{g!.title}</a></h3>
          <p>{g!.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap" style="margin-bottom:2rem">
    <div class="section-head">
      <h2>Browse by airline</h2>
      <label class="filter-label" for="airline-filter">
        Filter
        <input
          id="airline-filter"
          class="filter-input"
          type="search"
          placeholder="Name or IATA (e.g. DL, Emirates)"
          autocomplete="off"
        />
      </label>
    </div>
    <p class="muted" style="margin:0.35rem 0 0">
      Primary path for SEO and bookings: pick a carrier, open a seat map, then use the booking placeholder CTA.
    </p>
    <div class="grid cols-3" style="margin-top:1rem" id="airline-grid">
      {airlineCards.map((a) => (
        <article class="card airline-card" data-filter={`${a.name} ${a.iata} ${a.country} ${a.slug}`.toLowerCase()}>
          <span class="badge">{a.iata}</span>
          <h3><a class="stretched" href={`/airlines/${a.slug}/`}>{a.name}</a></h3>
          <p>{a.blurb}</p>
          <p class="muted" style="margin-top:0.45rem">{a.count} schematic config{a.count === 1 ? '' : 's'}</p>
        </article>
      ))}
    </div>
    <p id="filter-empty" class="muted" hidden style="margin-top:1rem">No airlines match that filter.</p>
  </section>

  <section class="wrap" style="margin-bottom:2rem">
    <div class="section-head">
      <h2>Featured cabin schematics</h2>
      <a href="/airlines/">See all airlines →</a>
    </div>
    <div class="grid cols-2" style="margin-top:1rem">
      {featured.map((c) => {
        const airline = airlines.find((a) => a.slug === c.airlineSlug)!;
        const ap = aircraftUrlParam(c);
        return (
          <article class="card">
            <span class="badge">{airline.name}</span>
            <h3><a href={`/airlines/${airline.slug}/${ap}/seat-map/`}>{c.aircraftType}</a></h3>
            <p>
              About {c.totalSeatsApprox} seats · economy layout {layoutString(c)}
            </p>
            <p class="btn-row" style="margin-bottom:0">
              <a class="btn secondary" href={`/airlines/${airline.slug}/${ap}/seat-map/`}>Seat map</a>
              <a class="btn" href={`/best-seats/${airline.slug}/${ap}/`}>Best seats</a>
            </p>
          </article>
        );
      })}
    </div>
  </section>

  <section class="wrap" style="margin-bottom:2.5rem">
    <div class="section-head">
      <h2>Also browse</h2>
    </div>
    <div class="grid cols-3" style="margin-top:1rem">
      <article class="card">
        <h3><a href="/aircraft/">Aircraft index</a></h3>
        <p>Jump by type (737, A320, widebodies) across airlines.</p>
      </article>
      <article class="card">
        <h3><a href="/guides/">Guides index</a></h3>
        <p>Evergreen seat strategy with outbound citations.</p>
      </article>
      <article class="card">
        <h3><a href="/book/">Booking stub</a></h3>
        <p>Affiliate ready placeholder with disclosure links.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById('airline-filter');
  const cards = Array.from(document.querySelectorAll('.airline-card'));
  const empty = document.getElementById('filter-empty');
  input?.addEventListener('input', () => {
    const q = (input).value.trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const hay = card.getAttribute('data-filter') || '';
      const match = !q || hay.includes(q);
      card.toggleAttribute('hidden', !match);
      if (match) shown += 1;
    }
    if (empty) empty.hidden = shown > 0;
  });
</script>
