---
import Photo from '../components/Photo.astro';
import { photoForText, pickPhoto, photoForAircraft } from '../lib/photos';
import { ORGANIZATION, PUBLISHER } from '../lib/schema';
import BaseLayout from '../layouts/BaseLayout.astro';
import { airlines, aircraftConfigs, layoutString, getAircraftByAirline } from '../data';
import { aircraftUrlParam } from '../lib/resolve';
import guides from '../data/guides.json';
import news from '../data/news.json';

const featured = [
  ...aircraftConfigs.slice(-6),
  ...aircraftConfigs.slice(0, 2),
].filter((c, i, arr) => arr.findIndex((x) => x.slug === c.slug) === i).slice(0, 8);
const airlineCards = airlines.map((a) => ({
  ...a,
  count: getAircraftByAirline(a.slug).length,
}));
const latestNews = [...news].sort((a, b) => b.datePublished.localeCompare(a.datePublished)).slice(0, 3);
const inventoryLine = `${airlines.length} airlines, ${aircraftConfigs.length} aircraft configs, ${guides.length} guides`;

const featuredGuideSlugs = [
  'southwest-assigned-seating-guide',
  'do-exit-row-seats-recline',
  'ryanair-737-8200-seats',
  'seat-map-glossary',
  'cabin-class-primer',
  'how-pickyourrow-scores-work',
  'exit-row-tips',
  'seat-pitch-and-width-explained',
  'how-to-verify-your-aircraft-type',
  'seat-selection-checklist-before-you-fly',
  'unassigned-seats-versus-paid-selection',
];
const featuredGuides = [
  ...featuredGuideSlugs.map((s) => guides.find((g) => g.slug === s)).filter(Boolean),
  ...guides.filter((g) => !featuredGuideSlugs.includes(g.slug)),
].slice(0, 6);

const jsonLd = [
  ORGANIZATION,
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
    { '@type': 'Question', name: "Are Pick Your Row seat maps official airline maps?", acceptedAnswer: { '@type': 'Answer', text: "No. They are original illustrative schematics drawn from public layout facts. Always confirm your seat on the airline's own seat map before you fly." } },
    { '@type': 'Question', name: "How do I know which aircraft my flight uses?", acceptedAnswer: { '@type': 'Answer', text: "Check the aircraft type in your booking or the airline app, then open the matching map here. Our guide on verifying your aircraft type walks through it." } },
    { '@type': 'Question', name: "Which seats are usually best on a short flight?", acceptedAnswer: { '@type': 'Answer', text: "An aisle near the front saves time at the gate, while an exit row gives extra legroom if you meet the rules. Seats beside lavatories and the last row are usually the ones to avoid." } },
    { '@type': 'Question', name: "Do exit row seats recline?", acceptedAnswer: { '@type': 'Answer', text: "Often the rear exit row reclines and the row directly in front of an exit does not. See our exit row recline guide for the details." } },
    { '@type': 'Question', name: "Does Southwest still have open seating?", acceptedAnswer: { '@type': 'Answer', text: "No. Southwest moved to assigned seats on flights from 27 Jan 2026, so you choose or are given a seat rather than picking one at boarding." } },
    { '@type': 'Question', name: "Is Pick Your Row free to use?", acceptedAnswer: { '@type': 'Answer', text: "Yes. Every seat map and guide is free to read." } }
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Pick Your Row',
    url: 'https://pickyourrow.com/',
    description:
      'Original schematic seat maps and editorial best seat tips for popular airline aircraft.',
    publisher: PUBLISHER,
  },
];
---
<BaseLayout
  title="Pick Your Row: airline seat maps and cabin guides"
  description="Original schematic seat maps and editorial best seat tips for popular airline aircraft. Browse by airline, pick a smarter row, then use our booking placeholder when you are ready. Not affiliated with any airline."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section class="hero wrap home-hero">
   <div>
    <p class="badge">Original schematics · editorial guidance</p>
    <h1>See the cabin. Pick a smarter row. Book with eyes open.</h1>
    <p class="lede">
      Pick Your Row publishes original SVG cabin schematics and plain English seat notes for common airline
      configurations. Rebuilt from publicly known layout facts. Never scraped from competitor maps.
      Currently covering {inventoryLine}.
    </p>
    <div class="btn-row">
      <a class="btn" href="/airlines/">Browse airlines</a>
      <a class="btn secondary" href="/methodology/">Methodology and sources</a>
      <a class="btn secondary" href="/guides/">Seat selection guides</a>
    </div>
    <p class="note info">
      Configurations vary by aircraft registration and retrofit. Treat every map as an illustrative schematic and
      confirm seats with your airline. We are not affiliated with any carrier.
    </p>
   </div>
   <Photo name="economy-cabin" variant="hero" eager />
  </section>

  <section class="wrap trust-row" aria-label="Trust signals">
    <div class="trust-row__grid">
      <div class="trust-row__item">
        <strong>Original only</strong>
        <span>Hand built SVG schematics. No scraped SeatGuru or airline PDF diagrams.</span>
      </div>
      <div class="trust-row__item">
        <strong>Editorial scores</strong>
        <span>Transparent heuristics on <a href="/methodology/">Methodology</a>. Not airline advice.</span>
      </div>
      <div class="trust-row__item">
        <strong>Clear disclosure</strong>
        <span>Booking placeholders link to <a href="/disclosure/">disclosure</a> and <a href="/book/">/book/</a>.</span>
      </div>
      <div class="trust-row__item">
        <strong>Human contact</strong>
        <span><a href="/about/">About</a> Pick Your Row · <a href="/contact/">Contact</a></span>
      </div>
    </div>
  </section>

  <section class="wrap" style="margin-bottom:2rem">
    <div class="section-head">
      <h2>Featured guides</h2>
      <a href="/guides/">All guides →</a>
    </div>
    <div class="grid cols-3" style="margin-top:1rem">
      {featuredGuides.map((g) => (
        <article class="card">
          <Photo name={photoForText(g!.title + ' ' + g!.slug, g!.slug)} variant="thumb" />
          <h3><a href={`/guides/${g!.slug}/`}>{g!.title}</a></h3>
          <p>{g!.description}</p>
        </article>
      ))}
    </div>
  </section>

  {latestNews.length > 0 && (
    <section class="wrap" style="margin-bottom:2rem">
      <div class="section-head">
        <h2>Cabin news</h2>
        <a href="/news/">All news</a>
      </div>
      <div class="grid cols-3" style="margin-top:1rem">
        {latestNews.map((n) => (
          <article class="card">
            <Photo name={photoForText(n.title, n.slug)} variant="thumb" />
            <h3><a href={`/news/${n.slug}/`}>{n.title}</a></h3>
            <p>{n.description}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="wrap" style="margin-bottom:2rem">
    <div class="section-head">
      <h2>Browse by airline</h2>
      <label class="filter-label" for="airline-filter">
        Filter
        <input
          id="airline-filter"
          class="filter-input"
          type="search"
          placeholder="Name or IATA (e.g. DL, Emirates)"
          autocomplete="off"
        />
      </label>
    </div>
    <p class="muted" style="margin:0.35rem 0 0">
      Primary path for SEO and bookings: pick a carrier, open a seat map, then use the booking placeholder CTA.
    </p>
    <p class="photo-note">Photos on this site are AI generated illustrations of typical cabins and aircraft, not specific airlines or aircraft. Seat diagrams are exact and separate.</p>
    <div class="grid cols-3" style="margin-top:1rem" id="airline-grid">
      {airlineCards.map((a) => (
        <article class="card airline-card" data-filter={`${a.name} ${a.iata} ${a.country} ${a.slug}`.toLowerCase()}>
          <Photo name={pickPhoto(a.slug)} variant="thumb" />
          <span class="badge">{a.iata}</span>
          <h3><a class="stretched" href={`/airlines/${a.slug}/`}>{a.name}</a></h3>
          <p>{a.blurb}</p>
          <p class="muted" style="margin-top:0.45rem">{a.count} schematic config{a.count === 1 ? '' : 's'}</p>
        </article>
      ))}
    </div>
    <p id="filter-empty" class="muted" hidden style="margin-top:1rem">No airlines match that filter.</p>
  </section>

  <section class="wrap" style="margin-bottom:2rem">
    <div class="section-head">
      <h2>Featured cabin schematics</h2>
      <a href="/airlines/">See all airlines →</a>
    </div>
    <div class="grid cols-2" style="margin-top:1rem">
      {featured.map((c) => {
        const airline = airlines.find((a) => a.slug === c.airlineSlug)!;
        const ap = aircraftUrlParam(c);
        return (
          <article class="card">
            <Photo name={photoForAircraft(c.aircraftType)} variant="thumb" />
            <span class="badge">{airline.name}</span>
            <h3><a href={`/airlines/${airline.slug}/${ap}/seat-map/`}>{c.aircraftType}</a></h3>
            <p>
              About {c.totalSeatsApprox} seats · economy layout {layoutString(c)}
            </p>
            <p class="btn-row" style="margin-bottom:0">
              <a class="btn secondary" href={`/airlines/${airline.slug}/${ap}/seat-map/`}>Seat map</a>
              <a class="btn" href={`/best-seats/${airline.slug}/${ap}/`}>Best seats</a>
            </p>
          </article>
        );
      })}
    </div>
  </section>

  <section class="wrap" style="margin-bottom:2.5rem">
    <div class="section-head">
      <h2>Also browse</h2>
    </div>
    <div class="grid cols-2" style="margin-top:1rem">
      <article class="card">
        <h3><a href="/best-seats/">Best seats index</a></h3>
        <p>Editorial shortlists for every airline aircraft config we publish.</p>
      </article>
      <article class="card">
        <h3><a href="/aircraft/">Aircraft index</a></h3>
        <p>Jump by type (737, A320, widebodies) across airlines.</p>
      </article>
      <article class="card">
        <h3><a href="/guides/">Guides index</a></h3>
        <p>Evergreen seat strategy with outbound citations.</p>
      </article>
      <article class="card">
        <h3><a href="/book/">Booking stub</a></h3>
        <p>Affiliate ready placeholder with disclosure links.</p>
      </article>
    </div>
  </section>
  <section class="wrap" aria-labelledby="home-faq" style="margin-top:2rem">
    <h2 id="home-faq">Seat selection FAQ</h2>
    <details><summary>Are Pick Your Row seat maps official airline maps?</summary><p>No. They are original illustrative schematics drawn from public layout facts. Always confirm your seat on the airline's own seat map before you fly.</p></details>
    <details><summary>How do I know which aircraft my flight uses?</summary><p>Check the aircraft type in your booking or the airline app, then open the matching map here. Our guide on verifying your aircraft type walks through it.</p></details>
    <details><summary>Which seats are usually best on a short flight?</summary><p>An aisle near the front saves time at the gate, while an exit row gives extra legroom if you meet the rules. Seats beside lavatories and the last row are usually the ones to avoid.</p></details>
    <details><summary>Do exit row seats recline?</summary><p>Often the rear exit row reclines and the row directly in front of an exit does not. See our exit row recline guide for the details.</p></details>
    <details><summary>Does Southwest still have open seating?</summary><p>No. Southwest moved to assigned seats on flights from 27 Jan 2026, so you choose or are given a seat rather than picking one at boarding.</p></details>
    <details><summary>Is Pick Your Row free to use?</summary><p>Yes. Every seat map and guide is free to read.</p></details>
    <p><a href="/guides/how-to-verify-your-aircraft-type/">Verify your aircraft</a> · <a href="/guides/do-exit-row-seats-recline/">Exit row recline</a> · <a href="/guides/southwest-assigned-seating-guide/">Southwest assigned seating</a> · <a href="/guides/ryanair-737-8200-seats/">Ryanair 737 8200</a></p>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById('airline-filter');
  const cards = Array.from(document.querySelectorAll('.airline-card'));
  const empty = document.getElementById('filter-empty');
  input?.addEventListener('input', () => {
    const q = (input).value.trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const hay = card.getAttribute('data-filter') || '';
      const match = !q || hay.includes(q);
      card.toggleAttribute('hidden', !match);
      if (match) shown += 1;
    }
    if (empty) empty.hidden = shown > 0;
  });
</script>
