---
/**
 * "Before you book" box. No booking stub and no affiliate links (AdSense placeholder fix, 20 Nov 2026).
 * If real, labeled affiliate links are ever added, list the programs on /disclosure/ first.
 */
interface Props {
  airlineName: string;
  aircraftType: string;
  cabinHint?: string;
  seatMapHref?: string;
  bestSeatsHref?: string;
  compact?: boolean;
}

const {
  airlineName,
  aircraftType,
  cabinHint,
  seatMapHref,
  bestSeatsHref,
  compact = false,
} = Astro.props;

---
<aside class:list={['booking-cta', compact && 'booking-cta--compact']} aria-label="Before you book">
  <div class="booking-cta__body">
    <p class="booking-cta__kicker">Before you book</p>
    <h2 class="booking-cta__title">Check this cabin when you book</h2>
    <p class="booking-cta__text">
      This {airlineName} {aircraftType} map is an illustrative schematic.
      {cabinHint ? ` Focus on ${cabinHint}.` : ''}
      When you book, confirm the aircraft type and the seat map shown in {airlineName}'s own booking or seat selection
      page, because the layout for your exact flight is set by the airline.
    </p>
    <div class="btn-row" style="margin-bottom:0.35rem">
      {bestSeatsHref && <a class="btn" href={bestSeatsHref}>Editorial best seats</a>}
      {seatMapHref && <a class="btn secondary" href={seatMapHref}>Full seat map</a>}
    </div>
    <p class="booking-cta__fine">
      <a href="/disclosure/">Affiliate disclosure</a>
      ·
      <a href="/methodology/">Methodology</a>
      ·
      Not affiliated with {airlineName}.
    </p>
  </div>
</aside>
